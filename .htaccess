DirectoryIndex inicio.html home.html index.html

RewriteEngine On

# 1. Se a URL terminar em .html, redireciona permanentemente (301) para a versão limpa
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Se a URL não tiver extensão, busca internamente o arquivo .html correspondente
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

